# Konstbyte environment variables example
#
# NOTE: paste values without trailing spaces or newlines. A stray newline in
# NEXTAUTH_URL or NEXT_PUBLIC_METADATA_BASE silently corrupts generated URLs.

# Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_strong_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Comma-separated list of admin accounts. Required to reach /admin.
ADMIN_EMAILS=you@example.com

# Email login via Resend (recommended in production/Vercel)
RESEND_API_KEY=re_...
EMAIL_FROM="Konstbyte <no-reply@your-domain.se>"

# Optional SMTP fallback (used only if RESEND_API_KEY is not set)
EMAIL_SERVER=smtp://user:pass@smtp.mailtrap.io:587

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Platform commission on sales, in percent (defaults to 3)
PLATFORM_FEE_PERCENT=3

# Swish payments
SWISH_MERCHANT_NUMBER=1234567890

# UploadThing
UPLOADTHING_SECRET=your_uploadthing_secret
NEXT_PUBLIC_UPLOADTHING_ENDPOINT=https://uploadthing.example

# Supabase — required by /api/lead; the build fails without these
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Hemsidor lead notifications (Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=

# OpenAI
OPENAI_API_KEY=sk-...

# SEO & Metadata base URL (used for canonical URLs, JSON-LD, OG images)
NEXT_PUBLIC_METADATA_BASE=https://www.konstbyte.se

# Groq (used for AI art valuation vision model)
GROQ_API_KEY=gsk_...

# Other
NODE_ENV=development
